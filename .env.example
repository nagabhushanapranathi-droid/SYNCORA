# Core Flask Settings
FLASK_SECRET_KEY=change_this_to_a_random_secret_key
FLASK_DEBUG=True

# Centralized AI Gateway: FreeLLMAPI
# All SYNCORA AI features communicate exclusively with FreeLLMAPI.
# Upstream model routing (Gemini, Llama, Claude, etc.) is handled by FreeLLMAPI.
SYNCORA_AI_ENABLED=true
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=freellmapi-6475c2b2c7ec1408ea5b9eb68cd1a8aa09584c3c5daefe1e
FREELLMAPI_DEFAULT_MODEL=auto
FREELLMAPI_TIMEOUT=60
FREELLMAPI_MAX_RETRIES=2

# Task-Specific Model Overrides (Optional - defaults to auto-discovery or default model)
# FREELLMAPI_MODEL_FAST=gemini-2.5-flash
# FREELLMAPI_MODEL_REASONING=gemini-2.5-pro
# FREELLMAPI_MODEL_BALANCED=gemini-2.5-flash
# FREELLMAPI_MODEL_ANALYTICS=gemini-2.5-pro

# Legacy Compatibility Providers (OpenAI-compatible / Secondary Fallback)
AI_PRIMARY_PROVIDER=freellmapi
AI_FALLBACK_PROVIDER=
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
