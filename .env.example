# Core Flask Settings
FLASK_SECRET_KEY=change_this_to_a_random_secret_key
FLASK_DEBUG=True

# Multi-Model AI Provider Configuration
# Primary & Fallback Provider selection: 'gemini', 'freellmapi', or 'openai'
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=freellmapi

# Google Gemini Configuration
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# FreeLLMAPI Configuration (OpenAI-compatible)
FREELLM_API_KEY=your_freellmapi_key_here
FREELLM_API_BASE=https://api.freellmapi.com/v1
FREELLM_MODEL=llama-3.3-70b

# Additional OpenAI-compatible Provider (Groq, DeepSeek, Ollama, OpenAI)
OPENAI_API_KEY=your_openai_compatible_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
